{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop client for DeepSeek Harness (dsh), driving a harness runtime subprocess over stdio JSON-RPC via the official SDK",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -b --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-spine-demo": "0.1.0-rc.7",
    "@deepseek-ai/dsh-fs-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sdk-client": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sdk-jsonrpc-demo": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-terminal": "0.1.0-rc.7",
    "@deepseek-ai/dsh-terminal-bash": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-bash-persistent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-str-replace-editor": "0.1.0-rc.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-vite": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
