{
  "name": "dsh-desktop-open-external",
  "description": "dsh-desktop built-in plugin: open the token-authenticated Web UI in the system browser from General settings",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
